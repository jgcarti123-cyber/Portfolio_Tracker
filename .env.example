# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# AI features (statement reading, trade sentences, the assistant). Leave LLM_API_KEY empty to run without AI.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER_NAME=Groq
# Optional: rough input-token budget per assistant request (Groq free tier allows 7,000 per minute).
# LLM_INPUT_BUDGET=4500
