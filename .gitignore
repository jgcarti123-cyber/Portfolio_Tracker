# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal statements used for building importers
/samples
/public/__samples__
# keep the template, never real env files
!.env.example

# statements or exports dropped in the project root (personal financial data)
/*.xlsx
/*.xls
/*.csv
/*.pdf

# local tool settings and logs
.claude/settings.local.json
*.log
